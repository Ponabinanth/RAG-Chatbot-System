# Supabase Configuration
# Replace with your actual Supabase project credentials from https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Existing backend (optional - for AI tools)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Google Gemini API Key (optional - enables real AI responses for assistants)
# Get a free key at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
